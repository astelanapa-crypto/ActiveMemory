# ActiveMemory Environment Variables
# Copy to .env and customize for your setup

# ==========================================
# Database (PostgreSQL with pgvector)
# ==========================================
AM_DB_HOST=localhost
AM_DB_PORT=5432
AM_DB_NAME=hermes_memory
AM_DB_USER=postgres
AM_DB_PASSWORD=postgres
AM_STORAGE_BACKEND=postgresql  # Or "sqlite" for fallback
AM_ENABLE_SQLITE_FALLBACK=true
AM_USE_PGVECTOR=true

# ==========================================
# Embeddings
# ==========================================
AM_EMBEDDING_ENDPOINT=http://192.168.1.199:8899/v1/embeddings  # Remote API (optional)
AM_EMBEDDING_MODEL=BAAI/bge-m3
AM_EMBEDDING_DIM=1024
AM_USE_LOCAL_EMBEDDING=true  # Use FastEmbed

# ==========================================
# Chunking
# ==========================================
AM_CHUNK_SIZE=512
AM_CHUNK_OVERLAP=50
AM_MAX_CHUNKS_PER_DOC=1000

# ==========================================
# Search
# ==========================================
AM_SEARCH_TOP_K=5
AM_HYBRID_ALPHA=0.5  # 0=vector only, 1=keyword only
AM_MIN_SCORE_THRESHOLD=0.1
AM_CONTEXT_MAX_TOKENS=4000
AM_CONTEXT_BOOST_IMPORTANCE=0.3
AM_CONTEXT_BOOST_PINNED=0.5

# ==========================================
# Redis Cache
# ==========================================
AM_USE_REDIS=true
AM_REDIS_URL=redis://localhost:6379/0
AM_CACHE_TTL=3600

# ==========================================
# Web Dashboard
# ==========================================
AM_WEB_HOST=0.0.0.0
AM_WEB_PORT=8788
AM_WEB_DEBUG=false
AM_WEB_SQLITE=false  # Legacy alias for SQLite

# ==========================================
# Security
# ==========================================
AM_REQUIRE_AUTH=false
AM_ENCRYPTION_KEY=your-secret-key-change-me
AM_ACCESS_LOG_RETENTION=30  # Days to keep access logs

# ==========================================
# Export & Snapshots
# ==========================================
AM_SNAPSHOT_DIR=data/snapshots
AM_SNAPSHOT_RETENTION_DAYS=7
AM_AUTO_SNAPSHOT=false
AM_AUTO_SNAPSHOT_INTERVAL=24  # Hours

# ==========================================
# Visualization & Analytics
# ==========================================
AM_CLUSTERING_METHOD=tsne  # tsne, umap, or pca
AM_CLUSTERING_PERPLEXITY=30
AM_HEATMAP_RESOLUTION=daily  # daily, weekly, monthly
AM_ENABLE_HEATMAP=true

# ==========================================
# Telegram Bot
# ==========================================
TG_BOT_TOKEN=your_bot_token_from_BotFather
TG_ADMIN_IDS=12345678  # Your Telegram user ID
TG_ALLOWED_USERS=  # Comma-separated user IDs (empty = admin only)

# ==========================================
# Hermes Agent Integration (MCP Client)
# ==========================================
# Hermes will connect to ActiveMemory via MCP
# Add to Hermes config.yaml:
# mcp_servers:
#   active-memory:
#     command: "active-memory-mcp"
#     args: []
